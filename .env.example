# Copy to .env.local (git-ignored) and adjust for your machine.
# Base URL of the Orbit FastAPI backend.
VITE_ORBIT_API_URL=http://localhost:8000
# Only used by the socket.io chat transport.
VITE_ORBIT_SOCKET_URL=http://localhost:8000
# Chat transport: mock | websocket | socket | http. Native WebSocket is the default.
VITE_ORBIT_CHAT_TRANSPORT=websocket
